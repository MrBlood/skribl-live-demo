# REQUIRED in production. Generate one and never commit the real value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left blank on purpose: a shipped placeholder is a publicly-known signing key,
# and production refuses to boot on it (see app.py). Local dev needs nothing —
# a per-process random key is generated when this is unset.
SECRET_KEY=

# Set this to 'production' on any real deployment. Skribl also auto-detects
# common platforms (Render, Heroku, Fly, Cloud Run, ECS, Kubernetes, gunicorn/
# uWSGI), but detection is positive-only: an unrecognised host with none of
# those markers is treated as dev, which means an ephemeral secret and
# per-process rate limiting. Setting this makes the choice explicit rather
# than leaving it to a heuristic.
# SKRIBL_ENV=production
DATABASE_URL=sqlite:///skribl_demo.db
# Production REFUSES to boot with DATABASE_URL unset: the fallback is a SQLite
# file on this host's disk, which most hosts rebuild on every deploy. Set this
# to 1 only if a local file on a disk that survives deploys is really the plan.
# SKRIBL_ALLOW_SQLITE=1
MAX_CONTENT_LENGTH=25000000

# Content-Security-Policy: on (default) | report-only | off
# report-only sends the policy without enforcing, so a deploy can watch for
# violations first. off is the emergency escape hatch.
SKRIBL_CSP=on

# Per-item media caps for POST /api/skribls, in bytes (decoded, not base64).
SKRIBL_MAX_AUDIO_BYTES=12000000
SKRIBL_MAX_IMAGE_BYTES=8000000

# Everything in a posted payload that the caps above and the structural limits
# do NOT already bound -- unknown keys, and known ones nothing walks -- measured
# as serialised JSON with strokes, stroke groups and media removed. A real
# Skribl's remainder is a few hundred bytes whatever the drawing weighs, so this
# is deliberately far above normal use and still far below what an unbounded key
# was worth: gzip turns 23 KB on the wire into a 24 MB row without it. Raise it
# only if a client legitimately needs to carry more metadata than this.
SKRIBL_MAX_PAYLOAD_EXTRA_BYTES=256000

# Posts allowed per IP per hour.
SKRIBL_RATE_MAX_POSTS=20

# Rate limiting (review fixes). Attempts cover ALL requests; posts are charged
# only on a committed post, so malformed requests can't exhaust the post quota.
SKRIBL_RATE_MAX_ATTEMPTS=200
# Number of trusted proxies in front of the app. 0 (default) = ignore
# X-Forwarded-For entirely and rate-limit on remote_addr. Set to the REAL number
# for your edge; on a single-proxy host like Render that is 1.
# A setting that disagrees with the traffic is logged once per process (a
# forwarded header while this is 0, fewer hops than it names, or none at all).
SKRIBL_TRUSTED_PROXIES=0
# Origins allowed to iframe the public player, e.g. "'self' https://skribls.net".
# Unset = player framing unrestricted (previous behaviour). Editors and the API
# are always locked to 'self'.
SKRIBL_EMBED_ORIGINS=
# Where Skribl mounts, e.g. /skribl. Unset = at the root (/skribl-pad, ...).
# No template or script names a route by literal path, so this is the whole move.
# SKRIBL_URL_PREFIX=/skribl
# The site this demo lives inside, for "Back to ..." once a drawing has posted
# (create_blueprint's home_url and home_label; docs/INTEGRATION.md). Unset, a
# standalone site, there is no such button. An http(s) address or a path; a
# path needs a label.
# SKRIBL_HOME_URL=https://skribls.net/home
# SKRIBL_HOME_LABEL=skribls.net
# Structural complexity caps. SKRIBL_MAX_POINTS_PER_FRAME is a Flip PAGE's.
SKRIBL_MAX_FRAMES=200
SKRIBL_MAX_POINTS_PER_FRAME=20000
SKRIBL_MAX_TOTAL_POINTS=200000
# A Pad drawing is one frame and may use the whole budget: it defaults to
# SKRIBL_MAX_TOTAL_POINTS, with strokes at the page's ratio of four points each.
# SKRIBL_MAX_POINTS_PER_PAD=200000
# SKRIBL_MAX_GROUPS_PER_PAD=50000
SKRIBL_MAX_CANVAS_EDGE=4096
SKRIBL_MAX_HOLD=8

# Rate-limit backend: 'memory' (per-process) or 'db' (shared across workers,
# survives restarts). 'db' uses the existing database — no Redis needed. Leave
# this UNSET in production: app.py then auto-selects 'db' for you. Setting it
# here to 'memory' would override that and silently keep per-process limiting,
# which grants N times the budget behind N workers. Uncomment only to force a
# choice.
# SKRIBL_RATE_BACKEND=memory
# How long an unresolved post reservation holds a slot (seconds). Bounds the cost
# of a process killed mid-post; only relevant with SKRIBL_RATE_BACKEND=db.
SKRIBL_RATE_PENDING_TTL=120
# How long a pending-media claim protects a freshly-referenced object from
# the orphan sweep (seconds). Bounds a poster that crashed between writing
# media and committing its post; not the media grace period.
SKRIBL_MEDIA_CLAIM_TTL=300

# --- knobs that existed but were documented nowhere ---------------------------
# Found by cross-checking every SKRIBL_* the code reads against every SKRIBL_*
# any document names. These six were read at runtime and appeared in no file a
# deployer would ever open, which matters more now the repository is public.

# Identity-hash key for the rate limiter. A DEDICATED key, not SECRET_KEY:
# rotating the session secret would otherwise silently reset every quota as a
# side effect. Falls back to SECRET_KEY so an existing deploy keeps working, and
# the 'db' backend REFUSES TO OPERATE with neither — a public default salt makes
# the IPv4 space trivially precomputable and the hashing decorative.
# SKRIBL_RATE_HMAC_KEY=

# Set to 1 to allow booting with an empty or placeholder SECRET_KEY on a host
# that otherwise looks like production. This is an ESCAPE HATCH FOR TESTING and
# nothing else: with a guessable key anyone can forge a Flask session, a CSRF
# double-submit token, or the rate limiter's identity HMAC. Production refuses
# to boot without it for that reason — do not set it to work around the refusal.
# SKRIBL_ALLOW_EPHEMERAL_SECRET=1

# Force the Secure attribute on cookies. Set this when the app is served over
# HTTPS but cannot tell — behind a proxy that terminates TLS and does not
# forward the scheme, which is the common case.
# SKRIBL_FORCE_SECURE_COOKIES=1

# Hard byte ceiling on a request body, checked alongside MAX_CONTENT_LENGTH
# above (the smaller of the two wins). Defaults to 25000000.
# SKRIBL_MAX_REQUEST_BYTES=25000000

# Structural cap, the same family as SKRIBL_MAX_FRAMES above. Defaults to 5000.
# SKRIBL_MAX_GROUPS_PER_FRAME=5000

# How many expired rate-limit rows one cleanup pass deletes. Defaults to 500.
# SKRIBL_RATE_CLEANUP_BATCH=500

# --- media storage -----------------------------------------------------------
# inline (default) keeps base64 data URLs inside payload_json — v131 behaviour.
# local writes content-addressed files under SKRIBL_MEDIA_ROOT.
# s3 writes them to an S3-compatible bucket. Objects are served through
# /media/<key> in every case, so the visibility check on that route applies;
# put a CDN in front of it rather than handing out bucket URLs.
# SKRIBL_MEDIA_BACKEND=s3
# SKRIBL_S3_BUCKET=your-bucket
# SKRIBL_S3_REGION=eu-west-2
# SKRIBL_S3_ENDPOINT=https://s3.eu-west-2.amazonaws.com   # or MinIO/R2
# SKRIBL_S3_PREFIX=media/
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN

# --- a demo identity, so the gallery card has an author to show ---------------
# SKRIBL HAS NO USER TABLE. A host signs people in and tells Skribl who they
# are (docs/INTEGRATION.md, models.set_author_resolver), so a standalone demo
# posts anonymously and every gallery card renders with no author — the honest
# answer for an anonymous post, and a useless one for looking at the feature.
#
# Set this to a handle and app.py behaves the way a real host will: ONE signed-
# in user, whose id goes on new posts, described through the same resolver hook.
# Unset (the default) nothing runs and the demo is exactly as anonymous as it
# was. Posts made BEFORE it is set stay anonymous — their user_id is already
# NULL and nothing here invents one retroactively.
#
# ONLY A BROWSER THAT PRESENTED THE KEY IS SIGNED IN: open /demo-login, type
# the key into its one field and press Sign in (it is posted, never put in the
# address, and the browser can remember it like any password). That sets a
# signed session cookie; the same page's Sign out button clears it (a link to
# /demo-logout signs nobody out). Everybody else stays anonymous. Without a
# key of 16+ characters NOBODY is signed in and the demo runs anonymous, with
# a warning in the log -- before v317 the handle was every visitor's
# identity, which let anyone on the internet act as you. Treat the key like a
# password: it is the whole of the sign-in. Use a random one (e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(24))"`). Guesses
# spend the per-connection attempts budget. CHANGING THE KEY SIGNS EVERY
# BROWSER OUT, because the cookie holds a mark of the key, not your name.
#
# It also REQUIRES SKRIBL_CSRF_PROTECT=1 (create_app() refuses to boot without
# it and says so by name). The session cookie is HTTPS-only; for a plain-http
# local run set SKRIBL_DEMO_INSECURE_COOKIE=1.
# SKRIBL_DEMO_IDENTITY=your-handle
# SKRIBL_DEMO_LOGIN_KEY=a-long-random-secret
# SKRIBL_CSRF_PROTECT=1
#
# The rest is display only, all optional: what the card draws beside the handle.
# SKRIBL_DEMO_IDENTITY_NAME=Mr. B
# SKRIBL_DEMO_IDENTITY_AVATAR=https://media.example.net/avatar.png
# SKRIBL_DEMO_IDENTITY_URL=https://example.net/u/your-handle
# SKRIBL_DEMO_IDENTITY_VERIFIED=1

# ---- The skribls.net stand-in, at /host -----------------------------------
# app.py mounts examples/host_app at /host, beside Skribl: a pretend host with
# its own people and posts, whose Add to post asks about the Skribls gallery
# (examples/README.md). It is on unless this says 0. It keeps its own SQLite
# file (beside the demo's where that is SQLite, in the temp directory where it
# is PostgreSQL: test posts, gone on a redeploy); name another with the second.
# SKRIBL_STAND_IN=0
# SKRIBL_STAND_IN_DATABASE_URL=sqlite:////var/tmp/skribl-stand-in.db

# ---- The site, at /social ---------------------------------------------------
# app.py plugs the Skribl site (social/, docs/SOCIAL-SITE.md) into this same
# app beside Skribl: one Skribl and one database, so a drawing made in the Pad
# is a skribl on the site. Its frame (Home, Explore, Make) and its sign-in:
# invite-only, with passkeys, in tables of its own (social_..., on a migration
# chain of its own that gunicorn.conf.py runs at each start). It is on unless
# this says 0, and a site that cannot start is logged and left out.
# SKRIBL_SOCIAL=0
#
# THE FIRST PERSON'S INVITE CODE. An invite code, not a passkey: a one-time
# key to the front door. It works as an invite link only while the site has
# nobody, and makes that first person an admin (who then makes invites at
# /social/invites). Open https://<the site's address>/social/join#<this code>,
# pick a name and a handle, and tap Join with a passkey: the passkey is made
# then, by the phone or computer you join on. Once somebody has joined it
# lets nobody else in, so it can stay set; take it out once you are in. Use a
# long random one (16 characters at least; shorter lets nobody in):
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# From a shell instead (a laptop, or Render's shell): `flask --app app social
# invite --base https://<the site's address>` prints a join link, and
# `flask --app app social recover HANDLE --base ...` a recovery link for HANDLE.
# The site's people post from the Pad as themselves only with
# SKRIBL_CSRF_PROTECT=1 (as the stand-in identity above also needs).
# SKRIBL_SOCIAL_FIRST_INVITE=
