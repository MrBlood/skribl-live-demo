+                  f"pad {pm}, flip {fm}")
+
+    print("\nPARITY — no surface is silently erroring on load")
+    check("Pad loads without JS errors", not errs["pad"], "; ".join(errs["pad"][:2]))
+    check("Flip loads without JS errors", not errs["flip"], "; ".join(errs["flip"][:2]))
+
+    b.close()
+
+summarise_and_exit()
