+/* ---- help drawer search ---------------------------------------------------
+   46 entries across 7 sections is past the point where an accordion alone is
+   findable: locating one tip meant opening up to seven sections and scanning.
+   The field filters live, hides sections with no hits, and highlights matches.
+   Counts come from lib/helpsearch.js — no number is written by hand here. */
+.help-search {
+  display: flex; align-items: center; gap: 8px;
+  margin: 0 18px 6px;
+  padding: 0 10px;
+  /* An accent wash rather than another neutral surface. On --surface-raised
+     the field sat about 4% from the drawer behind it and read as a hairline,
+     not a control. The tint also marks it as the one INTERACTIVE thing among
+     static section cards, and it means focus deepens a colour already present
+     instead of introducing one. Composited over --surface-raised rather than
+     layered with opacity, so it does not shift if the drawer's ground moves. */
+  background: #161528;
+  border: 1px solid rgba(124, 92, 255, 0.28);
+  border-radius: 10px;
+}
+.help-search:focus-within {
+  border-color: var(--accent);
+  box-shadow: 0 0 0 3px rgba(124, 92, 255, 0.16);
+  background: #1a1830;
+}
+.help-search-icon { display: flex; color: var(--accent-bright); }
+.help-search-icon svg { width: 15px; height: 15px; }
+.help-search-input {
+  flex: 1 1 auto; min-width: 0;
+  height: 38px; padding: 0;
+  background: transparent; border: 0;
+  color: var(--text-primary); font: inherit; font-size: 13px;
+}
+/* The global `input:focus-visible` rule near the end of this file draws a 2px
+   outline at 3px offset. Inside a wrapper that already shows focus via
+   :focus-within, that is a SECOND purple ring 3px outside the first — two
+   concentric rounded rects, visibly doubled along the right edge. The wrapper
+   is what the user perceives as the field, so the ring belongs there; the
+   input's own outline is suppressed with matching specificity, since a plain
+   `outline: none` earlier in the file loses to the later rule. */
+.help-search .help-search-input:focus,
+.help-search .help-search-input:focus-visible { outline: none; }
+.help-search-input::placeholder { color: #a8b0bf; }
+/* Safari draws its own clear affordance; ours is Esc, which is discoverable
+   from the keyboard and does not shift the layout. */
+.help-search-input::-webkit-search-cancel-button { -webkit-appearance: none; }
+.help-search-count {
+  margin: 0 20px 10px;
+  font-size: 11.5px; color: var(--text-secondary);
+  min-height: 16px;
+}
+.help-hit {
+  background: rgba(124, 92, 255, 0.32);
+  color: var(--text-primary);
+  border-radius: 3px;
+  padding: 0 1px;
+}
+.help-empty { margin: 8px 18px 16px; padding: 26px 12px; text-align: center; }
+.help-empty[hidden] { display: none; }
+.help-empty-title { font-size: 13.5px; color: var(--text-primary); margin-bottom: 4px; }
+.help-empty-sub { font-size: 12px; color: var(--text-secondary); }
+/* [hidden] must win over the layout display. `.accordion-header` is
+   `display: flex` and `.accordion-body` has its own display, both of which
+   override the UA's `[hidden]{display:none}` — so setting .hidden in JS left
+   every section on screen showing a "0" badge during a no-match search. This is
+   the SECOND time this exact trap has been hit in this tree; scope layout
+   display with :not([hidden]) or pair it with a rule like this one. */
+.help-tip[hidden], .help-step[hidden],
+.accordion-header[hidden], .accordion-body[hidden] { display: none; }
+
+/* ---- Pad canvas row -------------------------------------------------------
+   Mirrors Flip's .flip-menu-row so the two menus read the same. The note line
+   below it carries the current dimensions and, for a legacy drawing, says the
+   canvas is a custom size rather than silently showing no selection. */
+.menu-row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 8px 14px 4px;
+}
+.menu-row-label {
+  font-size: 12px;
