+{# Shared "Report a problem" sheet — one source for Pad and Flip.
+   Opened by any element carrying data-skribl-report; wired by lib/report.js.
+
+   It COPIES rather than sends. There is no reporting endpoint, and adding one
+   would mean an unauthenticated write path, storage, and someone reading it.
+   The button says "Copy details" for that reason — a button labelled "Send"
+   that only copies would be a lie, and a tester who believed it would wait for
+   a reply that was never coming. #}
+<div class="menu-overlay report-overlay" id="reportOverlay" hidden>
+  <div class="menu-sheet report-sheet" id="reportSheet" role="dialog" aria-modal="true"
+       aria-labelledby="reportHead">
+    <div class="export-head" id="reportHead">Report a problem</div>
+    <div class="export-sub">
+      Copy these details and send them with what went wrong — they answer most of
+      the questions I'd have to ask you anyway.
+    </div>
+    <pre class="report-details" id="reportDetails" tabindex="0"></pre>
+    <div class="report-privacy">
+      Your drawing, titles and audio are not included.
+    </div>
+    <div class="report-actions">
+      <button type="button" class="panel-btn" id="reportClose">Close</button>
+      <button type="button" class="panel-btn report-primary" id="reportCopy">Copy details</button>
+    </div>
+  </div>
+</div>
