+  color: var(--text-secondary);
+}
+.menu-row .canvas-seg, .menu-row .hint-seg { --seg-h: 26px; margin-left: auto; }
+/* Tips is two buttons and Canvas is four, so right-aligning both left a 99px
+   hole between the word "Tips" and its switch while "Canvas" sat snug against
+   its own. Matching the widths closes it, and the two rows read as a pair. */
+.menu-row .hint-seg { width: 147px; }
+.menu-row .hint-seg button { flex: 1 1 0; }
+.menu-row .hint-seg button { min-width: 34px; padding: 0 7px; font-size: 11px; }
+.menu-row .canvas-seg button { min-width: 34px; padding: 0 7px; font-size: 11px; }
+.menu-row-note {
+  padding: 0 14px 8px;
+  font-size: 11px;
+  color: var(--text-secondary);
+}
+.menu-row-note:empty { display: none; }
+
+/* ---- Your Skribls tray ----------------------------------------------------
+   Reuses .help-search / .help-search-count so the two drawers share one field
+   treatment rather than growing a second one that drifts. */
+.posted-drawer { position: fixed; inset: 0; z-index: 320; display: flex;
+  align-items: center; justify-content: center; }
+.posted-drawer[hidden] { display: none; }
+.posted-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.5);
+  -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); }
+.posted-inner { position: relative; width: min(440px, calc(100vw - 32px));
+  max-height: min(560px, calc(100dvh - 64px)); display: flex; flex-direction: column;
+  background: var(--surface-panel); border: 1px solid var(--hairline-strong);
+  border-radius: 16px; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,0.55); }
+.posted-head { display: flex; align-items: center; justify-content: space-between;
+  padding: 14px 16px 10px; font-size: 15px; font-weight: 500; color: var(--text-primary); }
+.posted-close { background: none; border: 0; color: var(--text-secondary);
+  font-size: 15px; cursor: pointer; padding: 2px 4px; }
+.posted-search { margin-bottom: 6px; }
+.posted-list { flex: 1 1 auto; overflow-y: auto; padding: 4px 12px 12px; }
+.posted-row { display: flex; align-items: center; gap: 10px; padding: 9px;
+  border-radius: 12px; background: var(--surface-control);
+  border: 1px solid var(--hairline); margin-bottom: 7px; }
+.posted-row:hover { background: var(--surface-control-hover); }
+.posted-thumb { width: 42px; height: 34px; border-radius: 8px; flex: 0 0 auto;
+  display: flex; align-items: center; justify-content: center;
+  font-size: 15px; color: #d5cfff; background: rgba(124,92,255,0.18); }
+.posted-thumb-pad { background: rgba(91,140,255,0.18); }
+/* SVG now, not a font glyph: the two characters rendered at whatever weight and
+   baseline the system font chose, so they sat unevenly beside each other. */
+.posted-thumb svg { width: 17px; height: 17px; display: block; }
+.posted-main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column;
+  gap: 2px; text-decoration: none; color: inherit; }
+.posted-title { font-size: 13px; color: var(--text-primary);
+  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.posted-sub { font-size: 11px; color: var(--text-secondary); }
+.posted-copy { flex: 0 0 auto; background: transparent; font: inherit; font-size: 11.5px;
+  border: 1px solid var(--hairline-strong); color: var(--text-secondary);
+  padding: 5px 9px; border-radius: 8px; cursor: pointer; }
+.posted-copy:hover { color: var(--text-primary); }
+.posted-copy.done { color: var(--accent-bright); border-color: rgba(124,92,255,0.4); }
+.posted-del { flex: 0 0 auto; background: none; border: 0; color: var(--text-secondary);
+  font-size: 12px; cursor: pointer; padding: 4px 6px; border-radius: 6px; }
+.posted-del:hover { color: var(--danger, #f4326f); }
+.posted-empty { text-align: center; padding: 34px 16px; }
+.posted-empty-title { font-size: 13.5px; color: var(--text-primary); margin-bottom: 5px; }
+.posted-empty-sub { font-size: 12px; color: var(--text-secondary); line-height: 1.55; }
+.posted-foot { border-top: 1px solid var(--hairline); padding: 10px 16px;
+  display: flex; align-items: center; justify-content: space-between; gap: 10px;
+  font-size: 11px; color: var(--text-secondary); }
+.posted-clearbtn { background: none; border: 0; color: var(--text-secondary);
+  font: inherit; font-size: 11px; cursor: pointer; text-decoration: underline;
+  padding: 0; flex: 0 0 auto; }
+.posted-clearbtn[hidden] { display: none; }
+
+/* ---- report a problem -----------------------------------------------------
+   Reuses .menu-overlay / .menu-sheet so it inherits the scrim, the scroll
+   bound and the column anchoring already fixed for the other sheets. Centred
+   rather than dropped from the corner: it is a dialog you read, not a menu. */
+@media (min-width: 641px) {
+  #reportOverlay { justify-content: center; align-items: center; }
+  #reportSheet {
+    position: relative; top: auto; right: auto;
+    width: 420px; max-width: calc(100vw - 48px);
+    border-radius: 18px; padding: 10px;
+    transform-origin: center center;
+  }
+}
+.report-details {
+  margin: 8px 14px 6px; padding: 11px 12px;
+  background: var(--surface-raised);
+  border: 1px solid var(--hairline-strong); border-radius: 10px;
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  font-size: 11.5px; line-height: 1.6; color: var(--text-primary);
+  /* pre keeps the line breaks; wrapping stops a long user-agent string forcing
+     the sheet wider than the window. */
+  white-space: pre-wrap; word-break: break-word;
+  max-height: 210px; overflow-y: auto;
+}
+.report-privacy { margin: 0 16px 10px; font-size: 11px; color: var(--text-secondary); }
+.report-actions { display: flex; gap: 8px; padding: 0 14px 12px; }
+.report-actions .panel-btn { flex: 1 1 0; text-align: center; }
+.report-primary { background: var(--accent); border-color: transparent; color: #fff; }
+
+/* ---- tooltips -------------------------------------------------------------
+   A native `title` tooltip cannot be styled — not the corners, not the colour,
+   not the delay. It is OS chrome. lib/tooltip.js moves every title to data-tip
+   and draws this instead. Suppressed entirely on coarse pointers, where there
+   is no hover and a "tooltip" would fire on tap and cover what you pressed. */
+.skribl-tip {
+  position: fixed; z-index: 400; pointer-events: none;
+  max-width: 260px; padding: 7px 10px;
+  border-radius: 10px;
+  background: var(--surface-control-hover);
+  border: 1px solid var(--hairline-strong);
+  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
+  color: var(--text-primary);
+  font-size: 12px; line-height: 1.45; text-align: center;
+  opacity: 0; transform: translateY(3px);
+  transition: opacity 0.14s ease, transform 0.14s ease;
+}
+.skribl-tip.below { transform: translateY(-3px); }
+.skribl-tip.in { opacity: 1; transform: translateY(0); }
+.skribl-tip[hidden] { display: none; }
+@media (prefers-reduced-motion: reduce) {
+  .skribl-tip { transition: none; }
+}
+
+/* ---- first-use hints ------------------------------------------------------
+   A tooltip says what a control is; a hint says how to drive it, once. Sits
+   above the bottom toolbar rather than centred, so it never covers the canvas
+   the hint is telling you about. */
+.skribl-hint {
+  position: fixed; z-index: 380;
+  /* TOP, not bottom. At bottom: 96px it landed on Flip's filmstrip — covering
+     the thumbnails the page-move hint tells you to tap. Flip's bottom chrome
+     (page bar + strip + tools) is ~230px tall and Pad's is ~90, so no single
+     bottom offset clears both. The top is clear on every surface, and the
+     canvas is what a hint usually refers to. */
+  left: 50%; top: 84px; transform: translate(-50%, -8px);
+  max-width: min(360px, calc(100vw - 32px));
+  padding: 11px 14px;
+  border-radius: 12px;
+  background: var(--surface-control-hover);
+  border: 1px solid rgba(124, 92, 255, 0.35);
+  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55);
+  color: var(--text-primary);
+  font-size: 12.5px; line-height: 1.5; text-align: center;
+  cursor: pointer;
+  opacity: 0;
+  transition: opacity 0.2s ease, transform 0.2s ease;
+}
+.skribl-hint.in { opacity: 1; transform: translate(-50%, 0); }
+.skribl-hint[hidden] { display: none; }
+@media (prefers-reduced-motion: reduce) { .skribl-hint { transition: none; } }
